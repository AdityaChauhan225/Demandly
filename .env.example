# Demandly Environment Configuration

# Database: PostgreSQL (or sqlite:///geodemand.db for standalone local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geodemand

# Redis: Cache and streaming (falls back gracefully to memory/direct DB if unreachable)
REDIS_URL=redis://localhost:6379/0

# Privacy Settings
PRIVACY_K=5
PRIVACY_EPSILON=1.0
PRIVACY_SALT=geodemand-privacy-salt-change-in-production

# Serving & Caching
CACHE_TTL_SECONDS=300
MAX_CELLS=5000

# Security
INGEST_API_KEY=geodemand-dev-ingest-key
ALLOWED_ORIGIN=*

# Server
PORT=8000
HOST=0.0.0.0
